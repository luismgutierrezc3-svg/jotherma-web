# ══════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO - JOTHERMA
# ══════════════════════════════════════════════════════════
# IMPORTANTE: NO SUBIR ESTE ARCHIVO A GITHUB
# Renombra este archivo a .env y configura tus valores reales

# ── BASE DE DATOS ──
DATABASE_URL=postgresql://usuario:password@localhost:5432/jotherma_db
# O para servicios cloud:
# DATABASE_URL=postgresql://usuario:password@host.region.provider.com:5432/jotherma_db

# ── SEGURIDAD ──
JWT_SECRET=cambia_esto_por_una_clave_muy_segura_y_larga_minimo_32_caracteres
SESSION_SECRET=otra_clave_muy_segura_diferente_para_sesiones_minimo_32_caracteres

# ── SERVIDOR ──
PORT=3000
NODE_ENV=production

# ── DOMINIO ──
# En desarrollo usa http://localhost:3000
# En producción usa tu dominio real
FRONTEND_URL=https://tudominio.com
BACKEND_URL=https://api.tudominio.com

# ── ADMIN INICIAL (Solo para primera instalación) ──
# Después de crear el primer admin, borra estas líneas
INITIAL_ADMIN_EMAIL=admin@jotherma.org
INITIAL_ADMIN_PASSWORD=CambiaEstoInmediatamente123!
